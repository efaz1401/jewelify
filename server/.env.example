# --- Server ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Public canonical domain (no trailing slash) — used for canonical tags,
# Open Graph URLs, sitemap.xml and robots.txt
SITE_URL=http://localhost:5173

# --- Database (MongoDB Atlas) ---
# Get this from https://cloud.mongodb.com -> Connect -> Drivers
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/jewelify?retryWrites=true&w=majority

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Admin seeding ---
ADMIN_EMAIL=admin@jewelify.com
ADMIN_PASSWORD=AdminPass123!
